{
  "expo": {
    "name": "react-florestal",
    "slug": "react-florestal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/logo-parque.svg",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/logo-parque.svg",
        "backgroundColor": "#ffffff"
      },
      "package": "com.emanuel_cac.reactflorestal"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/logo-parque.svg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "05e7b168-7dd9-4932-9327-a6805272f157"
      }
    }
  }
}
